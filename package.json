{
  "name": "my-ng-wasm-app",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --port 4800",
    "dev": "ng serve --port 4800",
    "build": "bun run ng build",
    "watch": "ng build --watch --configuration development",
    "test": "vitest --setupFiles test-setup.ts",
    "test:ui": "vitest --ui",
    "serve:ssr:my-ng-wasm-app": "node dist/my-ng-wasm-app/server/server.mjs"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "bun@1.0.0",
  "dependencies": {
    "@angular/animations": "^21.0.3",
    "@angular/cdk": "^21.0.2",
    "@angular/common": "^21.0.0",
    "@angular/compiler": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/forms": "^21.0.0",
    "@angular/material": "^21.0.2",
    "@angular/platform-browser": "^21.0.0",
    "@angular/platform-server": "^21.0.0",
    "@angular/router": "^21.0.0",
    "@angular/ssr": "^21.0.2",
    "express": "^5.1.0",
    "photon-wasm": "^0.0.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "vite-plugin-angular": "^0.0.0"
  },
  "devDependencies": {
    "@angular/build": "^21.0.2",
    "@angular/cli": "^21.0.2",
    "@angular/compiler-cli": "^21.0.0",
    "@angular/platform-browser-dynamic": "^21.0.3",
    "@tailwindcss/forms": "0.5.7",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.19",
    "jsdom": "^27.1.0",
    "tailwindcss": "3.4.0",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}